<?xml version="1.0"?>
<sdf version="1.10">
  <world name="default">
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><box><size>30 20 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>30 20 0.1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.65 0.65 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pallet_A">
      <pose>4 0 0.18 0 0 0</pose>
      <link name="pallet_link">
        <inertial><mass>30</mass><inertia><ixx>1.5</ixx><iyy>2.4</iyy><izz>3.0</izz></inertia></inertial>
        <collision name="collision"><geometry><box><size>1.2 0.8 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.8 0.3</size></box></geometry><material><ambient>0.45 0.24 0.08 1</ambient><diffuse>0.55 0.32 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <model name="forklift">
      <pose>0 0 0.42 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>350</mass>
          <inertia><ixx>70</ixx><iyy>110</iyy><izz>130</izz></inertia>
        </inertial>
        <collision name="body_collision"><pose>-0.15 0 0.15 0 0 0</pose><geometry><box><size>1.7 1.0 0.65</size></box></geometry></collision>
        <visual name="body_visual"><pose>-0.15 0 0.15 0 0 0</pose><geometry><box><size>1.7 1.0 0.65</size></box></geometry><material><ambient>0.95 0.65 0.05 1</ambient><diffuse>1.0 0.72 0.08 1</diffuse></material></visual>
        <visual name="mast_visual"><pose>0.75 0 0.72 0 0 0</pose><geometry><box><size>0.12 1.0 1.65</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient></material></visual>
        <visual name="fork_left"><pose>1.15 0.28 -0.18 0 0 0</pose><geometry><box><size>0.95 0.10 0.08</size></box></geometry><material><ambient>0.16 0.16 0.16 1</ambient></material></visual>
        <visual name="fork_right"><pose>1.15 -0.28 -0.18 0 0 0</pose><geometry><box><size>0.95 0.10 0.08</size></box></geometry><material><ambient>0.16 0.16 0.16 1</ambient></material></visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.56 -0.17 1.570796 0 0</pose>
        <inertial><mass>18</mass><inertia><ixx>0.6</ixx><iyy>0.6</iyy><izz>0.9</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.16</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.56 -0.17 1.570796 0 0</pose>
        <inertial><mass>18</mass><inertia><ixx>0.6</ixx><iyy>0.6</iyy><izz>0.9</izz></inertia></inertial>
        <collision name="collision"><geometry><cylinder><radius>0.28</radius><length>0.16</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.28</radius><length>0.16</length></cylinder></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>

      <link name="rear_caster">
        <pose>-0.72 0 -0.24 0 0 0</pose>
        <inertial><mass>8</mass><inertia><ixx>0.15</ixx><iyy>0.15</iyy><izz>0.15</izz></inertia></inertial>
        <collision name="collision"><geometry><sphere><radius>0.18</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.08 0.08 0.08 1</ambient></material></visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child><axis><xyz>0 1 0</xyz></axis>
      </joint>
      <joint name="rear_caster_joint" type="ball"><parent>base_link</parent><child>rear_caster</child></joint>

      <link name="sensor_link">
        <pose>0.45 0 0.75 0 0 0</pose>
        <inertial><mass>0.1</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <sensor name="front_camera" type="camera">
          <topic>/camera</topic><update_rate>15</update_rate>
          <camera><horizontal_fov>1.25</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.1</near><far>20</far></clip></camera>
        </sensor>
        <sensor name="front_lidar" type="gpu_lidar">
          <topic>/scan</topic><update_rate>10</update_rate>
          <lidar><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan><range><min>0.12</min><max>15</max><resolution>0.02</resolution></range></lidar>
        </sensor>
      </link>
      <joint name="sensor_joint" type="fixed"><parent>base_link</parent><child>sensor_link</child></joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>1.12</wheel_separation>
        <wheel_radius>0.28</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
